<CarSearchLayout>:
    orientation: 'vertical'
    spacing: dp(15)
    padding: dp(20)

    # Main header and theme toggle
    MDBoxLayout:
        orientation: 'horizontal'
        adaptive_height: True
        spacing: dp(10)
        MDLabel:
            text: 'Car Data Explorer'
            font_style: 'H5'
            halign: 'left'
        MDIconButton:
            icon: 'theme-light-dark'
            on_release: root.toggle_theme()

    # Comparison buttons are now at the top
    MDBoxLayout:
        orientation: 'horizontal'
        adaptive_height: True
        spacing: dp(10)

        MDRaisedButton:
            text: "SELECT 1"
            size_hint_x: 0.5
            height: dp(40)
            on_release: root.select_car_for_comparison(self, 1)

        MDRaisedButton:
            text: "SELECT 2"
            size_hint_x: 0.5
            height: dp(40)
            on_release: root.select_car_for_comparison(self, 2)
    
    # Search input fields
    MDBoxLayout:
        orientation: 'horizontal'
        adaptive_height: True
        spacing: dp(10)

        MDTextField:
            id: make_input
            mode: "line"
            hint_text: "Make (e.g., Toyota)"
            size_hint_y: None
            height: dp(48)
            on_text_validate: root.search_car()

        MDTextField:
            id: model_input
            mode: "line"
            hint_text: "Model (e.g., Camry)"
            size_hint_y: None
            height: dp(48)
            on_text_validate: root.search_car()
    
    MDTextField:
        id: year_input
        mode: "line"
        hint_text: "Year (e.g., 2020)"
        input_filter: 'int'
        size_hint_y: None
        height: dp(48)
        on_text_validate: root.search_car()

    MDRaisedButton:
        text: "SEARCH"
        size_hint_x: 1
        height: dp(50)
        on_release: root.search_car()
        md_bg_color: app.theme_cls.primary_color

    MDLabel:
        id: status_label
        text: 'Enter a car to get started.'
        font_style: 'Body2'
        size_hint_y: None
        height: self.texture_size[1]
        halign: 'center'
        theme_text_color: "Secondary"
        markup: True
    
    # Car details display with scrolling
    ScrollView:
        MDLabel:
            id: single_result_label
            text: ''
            adaptive_height: True
            font_style: 'Body1'
            padding: dp(10)
            halign: 'left'
            theme_text_color: "Primary"
            text_size: self.width, None
            markup: True

    # Comparison display section
    MDBoxLayout:
        orientation: 'horizontal'
        adaptive_height: True
        spacing: dp(10)
        
        ScrollView:
            size_hint_x: 0.5
            MDLabel:
                id: car_1_label
                text: 'Slot 1: Empty'
                adaptive_height: True
                font_style: 'Body1'
                padding: dp(10)
                halign: 'left'
                theme_text_color: "Primary"
                text_size: self.width, None
                markup: True

        ScrollView:
            size_hint_x: 0.5
            MDLabel:
                id: car_2_label
                text: 'Slot 2: Empty'
                adaptive_height: True
                font_style: 'Body1'
                padding: dp(10)
                halign: 'left'
                theme_text_color: "Primary"
                text_size: self.width, None
                markup: True
    
    MDRaisedButton:
        text: "CLEAR COMPARISON"
        size_hint_x: 1
        height: dp(40)
        on_release: root.clear_comparison()

    # Corrected Analytics Layout
    MDLabel:
        id: analytics_status_label
        text: 'Click the button to generate and view a plot.'
        size_hint_y: None
        height: dp(40)
        halign: 'center'

    MDRaisedButton:
        text: 'Generate Analytics Plot'
        on_release: app.show_analytics_plot()
        size_hint_y: None
        height: dp(50)
    
    Image:
        id: plot_image
        source: ''
        allow_stretch: True
        keep_ratio: True